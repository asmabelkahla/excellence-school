# The Angular application does NOT read environment variables at runtime.
# Its API URL is fixed at build time in:
#   src/environments/environment.ts       (dev  -> http://localhost:3000/api)
#   src/environments/environment.prod.ts  (prod)
#
# On the hosting build, `node scripts/set-api-url.mjs` rewrites the prod URL from:
#   API_HOST=excellence-api.onrender.com      (set automatically by render.yaml), or
#   API_URL=https://api.my-school.tn/api
#
# Never put credentials or secrets in the front-end: everything under src/ is public.
# API variables live in server/.env (see server/.env.example).
