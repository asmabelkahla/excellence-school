PORT=3000
NODE_ENV=development

# Comma-separated list of allowed front-end origins
CORS_ORIGINS=http://localhost:4200

# 32+ random characters. Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=1d

# Either DATABASE_URL (Neon / Render) ...
DATABASE_URL=
# ... or individual settings (local docker-compose exposes 5434)
DB_HOST=localhost
DB_PORT=5434
DB_NAME=excellence_db
DB_USER=postgres
DB_PASSWORD=postgres
DB_SSL=false
DB_SYNCHRONIZE=false
DB_LOGGING=false

# Optional: creates the first super-admin if no admin exists yet
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Optional: Web Push (notifications on phones). Generate once with: npx web-push generate-vapid-keys
# Without them, dev uses temporary keys and production disables push (in-app notifications still work).
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:contact@excellence-school.tn
